# Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48

# Database password (internal to Docker, never exposed to the LAN)
POSTGRES_PASSWORD=change-me-long-random

# Signs login tokens. At least 32 characters. Changing it signs everyone out.
JWT_SECRET=change-me-at-least-32-characters-long-random

# First administrator — only used on the very first start (empty database).
# After you sign in and change the password, delete the ADMIN_PASSWORD line.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Local time zone for reports, day boundaries and backups (e.g. Africa/Accra, Africa/Lagos, Africa/Nairobi)
TZ=Africa/Accra

# Port the web app listens on (http://<mini-pc-ip>:8080)
APP_PORT=8080

# Backups: hour of day (0-23) and how many days to keep
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# Where backups are written on this PC (default: the backups folder next to ZENAA).
# For automatic cloud copies, use a folder synced by Google Drive / OneDrive / Dropbox, e.g.
#   BACKUP_PATH=C:/Users/you/My Drive/ZENAA backups
# BACKUP_PATH=./backups
